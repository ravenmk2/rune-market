# Release image: packages the goreleaser-built binary, never recompiles (§14).
# For a from-source multi-stage build see Dockerfile.
FROM alpine:3.21

RUN apk add --no-cache ca-certificates

COPY --chmod=755 runemarket /usr/local/bin/runemarket

WORKDIR /app
VOLUME /app/data
EXPOSE 8080

ENTRYPOINT ["runemarket"]
